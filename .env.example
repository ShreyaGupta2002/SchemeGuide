# Copy this file to .env and fill in your own values. Never commit .env.
#
# HOW TO GENERATE SECRETS
# -----------------------
# Django secret key (run this in your terminal):
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#
# Database password (run this in your terminal):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# POSTGRES_USER and POSTGRES_DB can be any name you choose.
# CATALOG_DATABASE_URL must use the same user/password/db you set below.
# Pattern: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>

# Django Catalog Service
CATALOG_SECRET_KEY=                     # generate with token_urlsafe(50)
CATALOG_DEBUG=true                      # set to false in production
CATALOG_DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>

# Eligibility Service
CATALOG_SERVICE_URL=http://catalog:8001

# AI Assistant Service — Groq API (free tier)
# 1. Create a free account at console.groq.com
# 2. Go to API Keys → Create API Key
# 3. Paste the key below
GROQ_API_KEY=                           # your Groq API key (starts with gsk_)
GROQ_MODEL=llama-3.1-8b-instant        # optional — this is the default

# Feedback Service
FEEDBACK_DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/feedback_db

# PostgreSQL — pick any username, dbname, and generate a password
POSTGRES_USER=                          # e.g. schemeguide
POSTGRES_PASSWORD=                      # generate with token_urlsafe(32)
POSTGRES_DB=                            # e.g. catalog_db
