# Copy this file to .env and fill in real values. Never commit .env.

# Django Catalog Service
CATALOG_SECRET_KEY=change-me-in-production
CATALOG_DEBUG=true
CATALOG_DATABASE_URL=postgresql://schemeguide:devpassword@db:5432/catalog_db

# Eligibility Service
CATALOG_SERVICE_URL=http://catalog:8001

# AI Assistant Service
ASSISTANT_DATABASE_URL=postgresql://schemeguide:devpassword@db:5432/ai_db
