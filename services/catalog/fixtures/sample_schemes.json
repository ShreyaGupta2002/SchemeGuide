  {
    "model": "schemes.sourcepassage",
    "pk": 1,
    "fields": {
      "source_document": 1,
      "text": "The scholarship is admissible to the children/wards of CAPF (Central Armed Police Forces) and Assam Rifles and RPF/RPSF personnel who were killed or disabled in duty.",
      "section_reference": "Section 2 — Eligibility Criteria"
    }
  },
  {
    "model": "schemes.sourcepassage",
    "pk": 2,
    "fields": {
      "source_document": 1,
      "text": "The candidate should not be more than 25 years of age and should be enrolled in first year of a degree or diploma course.",
      "section_reference": "Section 2 — Eligibility Criteria"
    }
  },
  {
    "model": "schemes.sourcepassage",
    "pk": 3,
    "fields": {
      "source_document": 2,
      "text": "The scholarship is open to students belonging to Scheduled Castes as defined under Article 341 of the Constitution of India.",
      "section_reference": "Para 3 — Eligibility"
    }
  },
  {
    "model": "schemes.sourcepassage",
    "pk": 4,
    "fields": {
      "source_document": 2,
      "text": "Annual income of parents/guardians of the student beneficiary from all sources should not exceed Rs. 2.5 lakh.",
      "section_reference": "Para 3 — Eligibility"
    }
  },
  {
    "model": "schemes.sourcepassage",
    "pk": 5,
    "fields": {
      "source_document": 3,
      "text": "Family income from all sources should not exceed Rs. 4.5 lakh per annum.",
      "section_reference": "Para 4 — Eligibility Conditions"
    }
  },
  {
    "model": "schemes.sourcepassage",
    "pk": 6,
    "fields": {
      "source_document": 3,
      "text": "The student should be in the age group of 18 to 25 years at the time of application.",
      "section_reference": "Para 4 — Eligibility Conditions"
    }
  },

