  {
    "model": "schemes.schemeversion",
    "pk": 1,
    "fields": {
      "scheme": 1,
      "version_number": 1,
      "description": "Provides financial assistance to children and widows of CAPF and RPF/RPSF personnel killed or disabled in duty. Awards 2000 scholarships per year — 1000 for boys and 1000 for girls.",
      "benefit_amount": "Rs. 2500/month for degree-level, Rs. 1900/month for diploma-level",
      "applicable_year": "2024-25",
      "application_open": "2024-08-01",
      "application_close": "2024-10-31",
      "official_url": "https://www.mha.gov.in/en/MHA-Scholarships",
      "status": "published",
      "created_at": "2026-01-01T00:00:00Z",
      "updated_at": "2026-01-01T00:00:00Z"
    }
  },
  {
    "model": "schemes.schemeversion",
    "pk": 2,
    "fields": {
      "scheme": 2,
      "version_number": 1,
      "description": "Financial assistance to Scheduled Caste students studying at post-matriculation or post-secondary stage to enable them to complete their education. Covers tuition fees, maintenance allowance, and other charges.",
      "benefit_amount": "Maintenance allowance Rs. 530–1200/month depending on course level",
      "applicable_year": "2024-25",
      "application_open": "2024-07-01",
      "application_close": "2024-11-30",
      "official_url": "https://socialjustice.gov.in/schemes/post-matric-scholarship-scheduled-castes",
      "status": "published",
      "created_at": "2026-01-01T00:00:00Z",
      "updated_at": "2026-01-01T00:00:00Z"
    }
  },
  {
    "model": "schemes.schemeversion",
    "pk": 3,
    "fields": {
      "scheme": 3,
      "version_number": 1,
      "description": "Scholarship for meritorious students pursuing regular courses at degree and post-degree level in colleges and universities. Aimed at students whose family income is below Rs 4.5 lakh per annum.",
      "benefit_amount": "Rs. 10,000/year for undergraduate, Rs. 20,000/year for postgraduate",
      "applicable_year": "2024-25",
      "application_open": "2024-09-01",
      "application_close": "2024-10-31",
      "official_url": "https://www.education.gov.in/scholarships-education-loan",
      "status": "published",
      "created_at": "2026-01-01T00:00:00Z",
      "updated_at": "2026-01-01T00:00:00Z"
    }
  },

